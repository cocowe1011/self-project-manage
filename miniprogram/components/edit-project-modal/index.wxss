/* components/edit-project-modal/index.wxss */
.edit-modal {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 50%;
}

.close-icon {
  line-height: 1;
}

.modal-body {
  padding: 24rpx 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #FF4D4F;
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #FAFAFA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.income-input-wrapper {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border-radius: 8rpx;
  padding: 0 24rpx;
}

.currency {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-right: 8rpx;
}

.income-input {
  background: transparent;
  padding-left: 0;
}

.form-textarea {
  width: 100%;
  height: 120rpx;
  background: #FAFAFA;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 48rpx;
}

.cancel-btn {
  flex: 1;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  border: none;
}

.submit-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #1677FF 0%, #4096ff 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  border: none;
}

.date-picker {
  display: flex;
  align-items: center;
}

.date-picker.placeholder {
  color: #999;
}
