/* pages/projects/index.wxss */
page {
  background: #F5F7FA;
  min-height: 100vh;
}

.projects-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 筛选区域 */
.filter-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-box {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-input {
  width: 100%;
  font-size: 28rpx;
}

.status-picker {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.picker-content {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  flex-shrink: 0;
}

/* 项目卡片 */
.project-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.project-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.07);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.project-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.3;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.status-not-started {
  background: #F5F5F5;
  color: #8C8C8C;
}

.status-in-development {
  background: #E6F4FF;
  color: #1677FF;
}

.status-development-complete {
  background: #F9F0FF;
  color: #722ED1;
}

.status-on-site-debugging {
  background: #FFF7E6;
  color: #FA8C16;
}

.status-delivered {
  background: #F6FFED;
  color: #52C41A;
}

.status-cancelled {
  background: #FFF1F0;
  color: #FF4D4F;
}

.card-body {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #8C8C8C;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

.info-value.amount {
  font-weight: 600;
  color: #333;
}

.card-footer {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
}

.finance-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.finance-label {
  font-size: 22rpx;
  color: #8C8C8C;
  margin-bottom: 6rpx;
}

.finance-value {
  font-size: 32rpx;
  font-weight: 700;
}

.finance-value.success {
  color: #52C41A;
}

.finance-value.warning {
  color: #FAAD14;
}

.finance-divider {
  width: 1rpx;
  height: 48rpx;
  background: #F0F0F0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8C8C8C;
  margin-bottom: 32rpx;
}

.empty-action {
  font-size: 28rpx;
  color: #1677FF;
  padding: 16rpx 32rpx;
  border: 2rpx solid #1677FF;
  border-radius: 8rpx;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1677FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 悬浮按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #1677FF 0%, #4096ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}

.fab-icon {
  line-height: 1;
}
